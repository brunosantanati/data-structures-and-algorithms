# Ignore the target directory where compiled files are placed
/target/

# Ignore Cargo.lock for libraries (not binaries)
# Uncomment if you're writing a library and don't want to lock dependencies
# Cargo.lock

# Ignore IDE/editor files
**/*.swp
**/*.swo
*.rs.bk
.idea/
.vscode/

# Ignore backup files
*~
*.bak

# Ignore test output and logs
*.log

# Ignore by-products of rust tooling
/.rustc_info.json
/.cargo-lock.cache

# Optional: Ignore files generated by CLion or other JetBrains IDEs
*.iml
*.ipr
*.iws

